{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pytest:*)",
      "Bash(dotnet:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(curl http://localhost:*)",
      "Bash(sh tools/*)",
      "Bash(wsl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(format:*)",
      "Bash(diskpart:*)",
      "Read(./deploy/.env)",
      "Read(**/.env)"
    ]
  }
}
