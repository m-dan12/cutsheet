{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutsheet.local/contracts/events/scene.ready-for-enrichment.v1.json",
  "title": "scene.ready-for-enrichment v1",
  "description": "Aggregator → Shot Type, Scene Description. Одно событие на сцену.",
  "allOf": [
    {
      "$ref": "../envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "scene.ready-for-enrichment"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "scene_id",
        "index",
        "start_ms",
        "end_ms",
        "keyframe_uris"
      ],
      "properties": {
        "scene_id": {
          "$ref": "../defs.v1.json#/$defs/uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start_ms": {
          "$ref": "../defs.v1.json#/$defs/ms"
        },
        "end_ms": {
          "$ref": "../defs.v1.json#/$defs/ms"
        },
        "keyframe_uris": {
          "type": "array",
          "items": {
            "$ref": "../defs.v1.json#/$defs/s3_uri"
          }
        },
        "replicas": {
          "type": "array",
          "items": {
            "$ref": "../defs.v1.json#/$defs/replica"
          }
        }
      }
    }
  }
}
