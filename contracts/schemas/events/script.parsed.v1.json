{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutsheet.local/contracts/events/script.parsed.v1.json",
  "title": "script.parsed v1",
  "description": "Script Parser → Transcription & Alignment. Структура сценария.",
  "allOf": [
    {
      "$ref": "../envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "script.parsed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "script_scenes",
        "roles"
      ],
      "properties": {
        "script_scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "heading",
              "lines"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "heading": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "line_id",
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "line_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "dialogue",
                        "action"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Канонические имена ролей в порядке первого появления"
        },
        "prompt_version": {
          "type": "string",
          "description": "Версия промпта LLM или эвристик, которыми размечен сценарий"
        },
        "role_aliases": {
          "type": "object",
          "description": "Варианты написания: канон → как встречалось в тексте (FR-SP3)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "parser": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "llm",
                "rules"
              ]
            },
            "model": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
