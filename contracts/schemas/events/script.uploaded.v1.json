{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutsheet.local/contracts/events/script.uploaded.v1.json",
  "title": "script.uploaded v1",
  "description": "Project API → Script Parser. Сценарий .docx загружен в S3.",
  "allOf": [
    {
      "$ref": "../envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "script.uploaded"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "script_uri",
        "filename"
      ],
      "properties": {
        "script_uri": {
          "$ref": "../defs.v1.json#/$defs/s3_uri"
        },
        "filename": {
          "type": "string"
        }
      }
    }
  }
}
