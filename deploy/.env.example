# Скопируйте в deploy/.env и поменяйте пароли. Значения ниже — только для локальной разработки.

POSTGRES_USER=cutsheet
POSTGRES_PASSWORD=cutsheet
POSTGRES_DB=cutsheet

S3_ACCESS_KEY=cutsheet
S3_SECRET_KEY=cutsheet-secret
S3_BUCKET=cutsheet

# Scene Detection (FR-SD1..3)
SD_DETECTOR=content
SD_THRESHOLD=27.0
SD_MIN_SCENE_MS=1000
SD_KEYFRAMES=3

# Адрес MinIO, на который подписываются presigned URL: по нему клиент грузит видео.
# Для клиента на другой машине — IP или имя хоста с Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Время жизни access-токена, минут (FR-AU2)
AUTH_ACCESS_MINUTES=15
