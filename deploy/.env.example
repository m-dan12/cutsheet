# Скопируйте в deploy/.env и поменяйте пароли. Значения ниже — только для локальной разработки.

POSTGRES_USER=cutsheet
POSTGRES_PASSWORD=cutsheet
POSTGRES_DB=cutsheet

S3_ACCESS_KEY=cutsheet
S3_SECRET_KEY=cutsheet-secret
S3_BUCKET=cutsheet

# Scene Detection (FR-SD1..3)
SD_DETECTOR=content
SD_THRESHOLD=27.0
SD_MIN_SCENE_MS=1000
SD_KEYFRAMES=3

# LLM (ТЗ 5.10): OpenAI-совместимый API. Ollama на хосте или --profile llm (http://ollama:11434/v1).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama

# Script Parser: llm или rules (эвристики без LLM)
SP_MODE=llm

# Transcription: faster-whisper (CPU) или whisperx (GPU, TA_EXTRAS=whisperx); модель small / large-v3
TA_BACKEND=faster-whisper
TA_MODEL=small
TA_LANGUAGE=ru
