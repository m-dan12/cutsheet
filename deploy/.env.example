# Скопируйте в deploy/.env и поменяйте пароли. Значения ниже — только для локальной разработки.

POSTGRES_USER=cutsheet
POSTGRES_PASSWORD=cutsheet
POSTGRES_DB=cutsheet

S3_ACCESS_KEY=cutsheet
S3_SECRET_KEY=cutsheet-secret
S3_BUCKET=cutsheet

# Scene Detection (FR-SD1..3)
SD_DETECTOR=content
SD_THRESHOLD=27.0
SD_MIN_SCENE_MS=1000
SD_KEYFRAMES=3

# Адрес MinIO, на который подписываются presigned URL: по нему клиент грузит видео.
# Для клиента на другой машине — IP или имя хоста с Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Время жизни access-токена, минут (FR-AU2)
AUTH_ACCESS_MINUTES=15

# LLM (ТЗ 5.10): OpenAI-совместимый API. Ollama на хосте или --profile llm (http://ollama:11434/v1).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama

# Script Parser: llm или rules (эвристики без LLM)
SP_MODE=llm

# Transcription: faster-whisper (CPU) или whisperx (GPU, TA_EXTRAS=whisperx); модель small / large-v3
TA_BACKEND=faster-whisper
TA_MODEL=small
TA_LANGUAGE=ru
# GigaAM (точнее на русской речи): TA_EXTRAS=gigaam, TORCH_INDEX=https://download.pytorch.org/whl/cpu,
# TA_BACKEND=gigaam. Текст от GigaAM, таймкоды слов от Whisper TA_MODEL (или TA_GIGAAM_TIMING=vad)
# TA_GIGAAM_MODEL=v3_e2e_rnnt
# TA_GIGAAM_TIMING=whisper

# Shot Type: модели MediaPipe качаются при первой сцене (Hugging Face не нужен)
ST_MAX_FRAMES=5
ST_MODEL_BASE_URL=https://storage.googleapis.com/mediapipe-models

# Scene Description: llm или stub (без LLM). Модель мультимодальная, своя (ollama pull qwen2.5vl:7b).
# Внешний API — только этими переменными: SDS_LLM_BASE_URL, SDS_LLM_MODEL, SDS_LLM_API_KEY,
# для него же SDS_LLM_RATE_LIMIT_RPM (запросов в минуту).
SDS_MODE=llm
SDS_LLM_BASE_URL=http://host.docker.internal:11434/v1
SDS_LLM_MODEL=qwen2.5vl:7b
SDS_LLM_API_KEY=ollama

# Aggregator: минут без ответов по проекту, после которых ожидающие сцены — enrichment_failed
ENRICHMENT_TIMEOUT_MINUTES=30
